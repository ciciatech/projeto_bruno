#!/bin/bash
# Auto-push para origin após cada commit em branches rastreadas.
# Acompanha a branch dev (desenvolvimento ativo da pipeline regional CE).

BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [[ "$BRANCH" == "dev" || "$BRANCH" == "main" ]]; then
    echo ""
    echo "Post-commit: pushing to origin/$BRANCH..."
    git push origin "$BRANCH" 2>&1
    if [[ $? -ne 0 ]]; then
        echo "WARN: auto-push falhou. Faça push manualmente depois."
    else
        echo "Auto-push OK — Mac Mini puxará nos próximos 5 min."
    fi
fi
